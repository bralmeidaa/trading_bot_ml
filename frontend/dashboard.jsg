// Dashboard JavaScript for Trading Bot ML

class TradingDashboard {
    constructor() {
        this.apiUrl = '/api';
        this.equityChart = null;
        this.refreshInterval = null;
        
        this.init();
    }
    
    init() {
        this.initializeCharts();
        this.loadInitialData();
        this.startAutoRefresh();
        this.setupEventListeners();
    }
    
    initializeCharts() {
        const ctx = document.getElementById('equityChart').getContext('2d');
        this.equityChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: 'Equity ($)',
                    data: [],
                    borderColor: '#667eea',
                    backgroundColor: 'rgba(102, 126, 234, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: {
                        type: 'time',
                        time: {
                            unit: 'minute',
                            displayFormats: {
                                minute: 'HH:mm'
                            }
                        },
                        title: {
                            display: true,
                            text: 'Hora'
                        }
                    },
                    y: {
                        beginAtZero: false,
                        ticks: {
                            callback: value => '$' + value.toLocaleString()
                        },
                        title: {
                            display: true,
                            text: 'Valor'
                        }
                    }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: context => `Equity: $${context.parsed.y.toLocaleString()}`
                        }
                    }
                }
            }
        });
    }

    async fetchData(endpoint) {
        try {
            const response = await fetch(`${this.apiUrl}${endpoint}`);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return await response.json();
        } catch (error) {
            console.error(`Error fetching ${endpoint}:`, error);
            this.showNotification(`Erro ao carregar dados de ${endpoint}`, 'error');
            return null;
        }
    }
    
    async loadInitialData() {
        await Promise.all([
            this.updateSystemStatus(),
            this.updatePerformanceMetrics(),
            this.updateBotStatus(),
            this.updateRecentTrades(),
            this.updateEquityChart(),
            this.updateLogs()
        ]);
    }
    
    async updateSystemStatus() {
        const data = await this.fetchData('/status');
        if (!data) return;

        const statusElement = document.getElementById('system-status');
        const modeElement = document.getElementById('trading-mode-status');
        
        if (data.running) {
            statusElement.innerHTML = '<i class="fas fa-circle status-running"></i> Online';
        } else {
            statusElement.innerHTML = '<i class="fas fa-circle status-stopped"></i> Offline';
        }
        
        if (data.paper_trading) {
            modeElement.innerHTML = '<i class="fas fa-file-invoice-dollar status-warning"></i> Paper Trading';
        } else {
            modeElement.innerHTML = '<i class="fas fa-rocket text-green-500"></i> Live Trading';
        }
        
        document.getElementById('system-uptime').textContent = data.uptime;
        // Also update the configuration form
        document.getElementById('config-total-capital').value = data.total_capital;
        document.getElementById('config-trading-mode').value = data.paper_trading ? "paper" : "live";
    }
    
    async updatePerformanceMetrics() {
        const data = await this.fetchData('/metrics');
        if (!data) return;

        document.getElementById('total-pnl').textContent = `$${data.total_pnl.toFixed(2)}`;
        document.getElementById('total-roi').textContent = `${(data.total_roi * 100).toFixed(2)}%`;
        document.getElementById('daily-pnl').textContent = `$${data.daily_pnl.toFixed(2)}`;
        document.getElementById('active-trades').textContent = data.active_trades;
        document.getElementById('win-rate').textContent = `${(data.win_rate * 100).toFixed(1)}%`;
        document.getElementById('total-trades').textContent = data.total_trades;
        document.getElementById('max-drawdown').textContent = `${(data.max_drawdown * 100).toFixed(2)}%`;
        
        this.updateMetricColors(data);
    }
    
    async updateBotStatus() {
        const data = await this.fetchData('/bots');
        if (!data || !data.bots) return;
        
        const botStatusContainer = document.getElementById('bot-status');
        botStatusContainer.innerHTML = '';
        
        if (data.bots.length === 0) {
            botStatusContainer.innerHTML = '<p class="text-gray-500">Nenhum bot ativo.</p>';
            return;
        }

        data.bots.forEach(bot => {
            const botElement = this.createBotStatusElement(bot);
            botStatusContainer.appendChild(botElement);
        });
    }
    
    async updateRecentTrades() {
        const data = await this.fetchData('/trades/recent');
        if (!data || !data.trades) return;
        
        const tradesTable = document.getElementById('trades-table');
        tradesTable.innerHTML = '';
        
        if (data.trades.length === 0) {
            tradesTable.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-gray-500">Nenhum trade recente.</td></tr>';
            return;
        }

        data.trades.forEach(trade => {
            const row = this.createTradeRow(trade);
            tradesTable.appendChild(row);
        });
    }
    
    async updateEquityChart() {
        const data = await this.fetchData('/equity');
        if (!data || !data.equity_curve) return;
        
        const labels = data.equity_curve.map(point => new Date(point.timestamp));
        const values = data.equity_curve.map(point => point.equity);
        
        this.equityChart.data.labels = labels;
        this.equityChart.data.datasets[0].data = values;
        this.equityChart.update();
    }

    async updateLogs() {
        const data = await this.fetchData('/logs');
        if (!data || !data.logs) return;

        const logsContainer = document.getElementById('logs-container');
        logsContainer.innerHTML = data.logs.map(log => `<p>${log}</p>`).join('');
        logsContainer.scrollTop = logsContainer.scrollHeight; // Scroll to bottom
    }

    createBotStatusElement(bot) {
        const div = document.createElement('div');
        div.className = 'flex items-center justify-between p-3 bg-gray-50 rounded-lg';
        
        const statusClass = bot.status === 'running' ? 'text-green-600' : 'text-yellow-600';
        const pnlClass = bot.pnl >= 0 ? 'text-green-600' : 'text-red-600';
        const iconClass = bot.status === 'running' ? 'bg-green-500' : 'bg-yellow-500';

        div.innerHTML = `
            <div class="flex items-center">
                <div class="w-3 h-3 rounded-full ${iconClass} mr-3"></div>
                <div>
                    <div class="font-medium">${bot.symbol} ${bot.timeframe}</div>
                    <div class="text-sm text-gray-500">${bot.trades} trades</div>
                </div>
            </div>
            <div class="text-right">
                <div class="font-medium ${pnlClass}">$${bot.pnl.toFixed(2)}</div>
                <div class="text-sm font-semibold ${statusClass}">${bot.status}</div>
            </div>
        `;
        return div;
    }
    
    createTradeRow(trade) {
        const row = document.createElement('tr');
        row.className = 'border-b border-gray-100 hover:bg-gray-50';
        
        const dirClass = trade.direction === 'LONG' ? 'text-green-600' : 'text-red-600';
        const pnlClass = trade.pnl >= 0 ? 'text-green-600' : 'text-red-600';
        const statusClass = trade.status === 'open' ? 'text-blue-600 font-semibold' : 'text-gray-600';
        
        row.innerHTML = `
            <td class="px-3 py-2 font-medium">${trade.symbol}</td>
            <td class="px-3 py-2 ${dirClass}">${trade.direction}</td>
            <td class="px-3 py-2">$${(trade.entry_price || 0).toFixed(4)}</td>
            <td class="px-3 py-2">$${(trade.exit_price || 0).toFixed(4)}</td>
            <td class="px-3 py-2 ${pnlClass}">$${trade.pnl.toFixed(2)}</td>
            <td class="px-3 py-2 ${statusClass}">${trade.status}</td>
            <td class="px-3 py-2 text-gray-500">${trade.time}</td>
        `;
        return row;
    }
    
    updateMetricColors(data) {
        document.getElementById('total-pnl').className = `text-2xl font-bold ${data.total_pnl >= 0 ? 'text-green-600' : 'text-red-600'}`;
        document.getElementById('total-roi').className = `text-sm font-semibold ${data.total_pnl >= 0 ? 'text-green-600' : 'text-red-600'}`;
        document.getElementById('daily-pnl').className = `text-2xl font-bold ${data.daily_pnl >= 0 ? 'text-blue-600' : 'text-red-600'}`;
        document.getElementById('win-rate').className = `text-2xl font-bold ${data.win_rate >= 0.6 ? 'text-orange-600' : 'text-gray-500'}`;
    }
    
    setupEventListeners() {
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                this.stopAutoRefresh();
            } else {
                this.loadInitialData();
                this.startAutoRefresh();
            }
        });
    }
    
    startAutoRefresh() {
        if (this.refreshInterval) clearInterval(this.refreshInterval);
        
        this.refreshInterval = setInterval(() => {
            this.updateSystemStatus();
            this.updatePerformanceMetrics();
            this.updateBotStatus();
            this.updateEquityChart();
            this.updateRecentTrades();
        }, 15000); // Refresh every 15 seconds

        // Refresh logs less frequently
         setInterval(() => {
            this.updateLogs();
        }, 60000); // Refresh logs every 60 seconds
    }
    
    stopAutoRefresh() {
        if (this.refreshInterval) {
            clearInterval(this.refreshInterval);
            this.refreshInterval = null;
        }
    }
    
    showNotification(message, type = 'info') {
        const notification = document.createElement('div');
        const bgColor = type === 'error' ? 'bg-red-500' : type === 'success' ? 'bg-green-500' : 'bg-blue-500';
        notification.className = `fixed top-5 right-5 p-4 rounded-lg shadow-lg text-white z-50 ${bgColor}`;
        notification.textContent = message;
        
        document.body.appendChild(notification);
        setTimeout(() => notification.remove(), 3000);
    }
}

// Global functions for UI interactions
function toggleSystem() {
    const modal = document.getElementById('emergency-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeEmergencyModal() {
    const modal = document.getElementById('emergency-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

async function postData(url, data) {
    try {
        const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        return response;
    } catch (error) {
        console.error(`Error posting to ${url}:`, error);
        dashboard.showNotification('Erro de comunicação com o servidor.', 'error');
        return null;
    }
}


async function emergencyStop() {
    const response = await postData('/api/emergency-stop', {});
    if (response && response.ok) {
        dashboard.showNotification('Sistema parado com sucesso!', 'success');
        await dashboard.updateSystemStatus();
    } else {
        dashboard.showNotification('Falha ao parar o sistema.', 'error');
    }
    closeEmergencyModal();
}

async function saveConfiguration() {
    const config = {
        trading_mode: document.getElementById('config-trading-mode').value,
        total_capital: parseFloat(document.getElementById('config-total-capital').value),
        daily_loss_limit: parseFloat(document.getElementById('config-daily-loss').value) / 100,
        daily_profit_target: parseFloat(document.getElementById('config-daily-profit').value) / 100
    };
    
    const response = await postData('/api/config', config);
    if (response && response.ok) {
        dashboard.showNotification('Configurações salvas com sucesso!', 'success');
        await dashboard.loadInitialData(); // Reload data to reflect changes
    } else {
        dashboard.showNotification('Erro ao salvar configurações.', 'error');
    }
}

// Initialize dashboard when page loads
let dashboard;
document.addEventListener('DOMContentLoaded', () => {
    dashboard = new TradingDashboard();
});