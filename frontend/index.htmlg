<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trading Bot ML - Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@^3"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@^2"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .card-shadow { box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
        .status-running { color: #10b981; }
        .status-stopped { color: #ef4444; }
        .status-warning { color: #f59e0b; }
        .log-container {
            height: 300px;
            background-color: #1E293B;
            color: #E2E8F0;
            font-family: 'Courier New', Courier, monospace;
            font-size: 0.875rem;
            padding: 1rem;
            border-radius: 0.5rem;
            overflow-y: scroll;
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen">
    <header class="gradient-bg text-white shadow-lg">
        <div class="container mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <i class="fas fa-robot text-2xl mr-3"></i>
                    <h1 class="text-2xl font-bold">Trading Bot ML</h1>
                </div>
                <div class="flex items-center space-x-6">
                    <div class="text-right">
                        <div class="text-sm opacity-75">Modo</div>
                        <div class="font-semibold" id="trading-mode-status">
                            <i class="fas fa-file-invoice-dollar status-warning"></i> Paper Trading
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="text-sm opacity-75">Uptime</div>
                        <div class="font-semibold" id="system-uptime">0:00:00</div>
                    </div>
                    <div class="text-right">
                        <div class="text-sm opacity-75">Sistema</div>
                        <div class="font-semibold" id="system-status">
                            <i class="fas fa-circle status-stopped"></i> Offline
                        </div>
                    </div>
                    <button onclick="toggleSystem()" class="bg-white bg-opacity-20 hover:bg-opacity-30 px-4 py-2 rounded-lg transition-all">
                        <i class="fas fa-power-off"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="container mx-auto px-6 py-8">
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-6 mb-8">
            <div class="bg-white rounded-xl p-6 card-shadow">
                <p class="text-gray-500 text-sm">PnL Total</p>
                <p class="text-2xl font-bold" id="total-pnl">$0.00</p>
                <span class="text-sm font-semibold" id="total-roi">0.00%</span>
            </div>
            <div class="bg-white rounded-xl p-6 card-shadow">
                <p class="text-gray-500 text-sm">PnL Diário</p>
                <p class="text-2xl font-bold" id="daily-pnl">$0.00</p>
            </div>
            <div class="bg-white rounded-xl p-6 card-shadow">
                <p class="text-gray-500 text-sm">Win Rate</p>
                <p class="text-2xl font-bold" id="win-rate">0%</p>
            </div>
            <div class="bg-white rounded-xl p-6 card-shadow">
                <p class="text-gray-500 text-sm">Trades Ativos</p>
                <p class="text-2xl font-bold" id="active-trades">0</p>
            </div>
            <div class="bg-white rounded-xl p-6 card-shadow">
                <p class="text-gray-500 text-sm">Trades Totais</p>
                <p class="text-2xl font-bold" id="total-trades">0</p>
            </div>
            <div class="bg-white rounded-xl p-6 card-shadow">
                <p class="text-gray-500 text-sm">Max Drawdown</p>
                <p class="text-2xl font-bold" id="max-drawdown">0.00%</p>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <div class="bg-white rounded-xl p-6 card-shadow">
                <h3 class="text-lg font-semibold mb-4">Curva de Equity</h3>
                <div class="h-80"><canvas id="equityChart"></canvas></div>
            </div>
            <div class="bg-white rounded-xl p-6 card-shadow">
                <h3 class="text-lg font-semibold mb-4">Status dos Bots</h3>
                <div class="space-y-4" id="bot-status">
                    </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="bg-white rounded-xl p-6 card-shadow lg:col-span-2">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold">Trades Recentes</h3>
                    <button onclick="dashboard.updateRecentTrades()" class="text-blue-600 hover:text-blue-800">
                        <i class="fas fa-refresh"></i>
                    </button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-3 py-2 text-left">Símbolo</th>
                                <th class="px-3 py-2 text-left">Direção</th>
                                <th class="px-3 py-2 text-left">Entrada</th>
                                <th class="px-3 py-2 text-left">Saída</th>
                                <th class="px-3 py-2 text-left">PnL</th>
                                <th class="px-3 py-2 text-left">Status</th>
                                <th class="px-3 py-2 text-left">Hora</th>
                            </tr>
                        </thead>
                        <tbody id="trades-table"></tbody>
                    </table>
                </div>
            </div>

            <div class="bg-white rounded-xl p-6 card-shadow">
                <h3 class="text-lg font-semibold mb-4">Configurações</h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Modo de Trading</label>
                        <select id="config-trading-mode" class="w-full p-2 border border-gray-300 rounded-lg">
                            <option value="paper">Paper Trading</option>
                            <option value="live">Live Trading</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Capital Total ($)</label>
                        <input type="number" id="config-total-capital" value="10000" class="w-full p-2 border border-gray-300 rounded-lg">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Limite Perda Diária (%)</label>
                        <input type="number" id="config-daily-loss" value="5" step="0.1" class="w-full p-2 border border-gray-300 rounded-lg">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Meta Lucro Diária (%)</label>
                        <input type="number" id="config-daily-profit" value="3" step="0.1" class="w-full p-2 border border-gray-300 rounded-lg">
                    </div>
                    <button onclick="saveConfiguration()" class="w-full bg-blue-600 text-white py-2 px-4 rounded-lg hover:bg-blue-700 transition-colors">
                        Salvar Configurações
                    </button>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl p-6 card-shadow mt-8">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold">Logs do Sistema</h3>
                <button onclick="dashboard.updateLogs()" class="text-blue-600 hover:text-blue-800">
                    <i class="fas fa-refresh"></i>
                </button>
            </div>
            <div id="logs-container" class="log-container">
                <p>Carregando logs...</p>
            </div>
        </div>
    </div>

    <div id="emergency-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
        <div class="bg-white rounded-xl p-8 max-w-md mx-4">
            <div class="text-center">
                <div class="bg-red-100 p-4 rounded-full w-16 h-16 mx-auto mb-4">
                    <i class="fas fa-exclamation-triangle text-red-600 text-2xl"></i>
                </div>
                <h3 class="text-xl font-semibold mb-2">Parada de Emergência</h3>
                <p class="text-gray-600 mb-6">Tem certeza que deseja parar todos os bots imediatamente?</p>
                <div class="flex space-x-4">
                    <button onclick="closeEmergencyModal()" class="flex-1 bg-gray-300 text-gray-700 py-2 px-4 rounded-lg hover:bg-gray-400 transition-colors">
                        Cancelar
                    </button>
                    <button onclick="emergencyStop()" class="flex-1 bg-red-600 text-white py-2 px-4 rounded-lg hover:bg-red-700 transition-colors">
                        Parar Sistema
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="dashboard.js"></script>
</body>
</html>