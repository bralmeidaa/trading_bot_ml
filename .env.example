# Copy to .env and fill with your values
BINANCE_API_KEY=
BINANCE_API_SECRET=
ENVIRONMENT=development
# SQLite path is relative to project root
DATABASE_URL=sqlite:///./database/trading.db

# AI trading agent (Azure AI Foundry, paper trading only). Unset = agent
# autostart logs a warning and skips (never blocks the API from booting).
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_DEPLOYMENT=gpt-5-mini
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21
